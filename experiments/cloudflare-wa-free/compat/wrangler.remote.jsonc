{
  "name": "sagamente-wa-baileys-remote-probe",
  "main": "./src/index.js",
  "compatibility_date": "2026-10-11",
  "workers_dev": true,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [{"name": "AUTH_TEST", "class_name": "EncryptedAuthProbe"}]
  },
  "migrations": [
    {"tag":"v1","new_sqlite_classes":["EncryptedAuthProbe"]}
  ],
  "vars": {
    "EXPERIMENTAL_PAIRING_ENABLED": "false"
  }
}
